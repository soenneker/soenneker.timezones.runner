<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net11.0</TargetFramework>
        <IsAotCompatible>true</IsAotCompatible>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <Platforms>AnyCPU</Platforms>
        <NoWarn>$(NoWarn);1591</NoWarn>
    </PropertyGroup>

    <PropertyGroup>
        <Description>Automatically updates the Soenneker.TimeZones.Data package</Description>
        <Version Condition="'$(BUILD_VERSION)' == ''">11.0.0</Version>
        <Version Condition="'$(BUILD_VERSION)' != ''">$(BUILD_VERSION)</Version>
        <AssemblyName>Soenneker.TimeZones.Runner</AssemblyName>
        <Copyright>Copyright © 2026 Jake Soenneker</Copyright>
        <Authors>Jake Soenneker</Authors>
        <Company>https://soenneker.com</Company>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <IsPackable>false</IsPackable>
        <LangVersion>latest</LangVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="11.0.0-rc.3.26522.148" />
        <PackageReference Include="Clipper2" Version="2.0.0" />
        <PackageReference Include="OsmSharp" Version="6.2.0" />
        <PackageReference Include="Soenneker.Python.Util" Version="11.0.477" />
        <PackageReference Include="Soenneker.Git.Util" Version="11.0.3873" />
        <PackageReference Include="Soenneker.GitHub.Repositories.Releases" Version="11.0.1111" />
        <PackageReference Include="Soenneker.Extensions.LoggerConfiguration" Version="11.0.1451" />
<PackageReference Include="Soenneker.Utils.Dotnet.NuGet" Version="11.0.2160" />
        <PackageReference Include="Soenneker.Utils.Environment" Version="11.0.787" />
<PackageReference Include="Soenneker.Utils.File.Download" Version="11.0.1834" />
</ItemGroup>
    <ItemGroup>
        <PackageReference Include="Soenneker.Enums.DeployEnvironment" Version="11.0.262" />
    </ItemGroup>
</Project>
